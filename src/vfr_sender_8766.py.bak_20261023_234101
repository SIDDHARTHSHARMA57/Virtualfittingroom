
import os, sys, json, time, socket, cv2
PROJECT = "/media/siddharth-sharam/Workspace/VirtualFittingRoom"
sys.path.insert(0, PROJECT)
from src.tracker import MediaPipePoseTracker
tracker = MediaPipePoseTracker(
    model_path=PROJECT+"/models/pose_landmarker_lite.task",
    min_conf=0.5)
cam = cv2.VideoCapture(0)
sock = socket.socket()
try:
    if not cam.isOpened():
        raise RuntimeError("Camera 0 could not open")
    while True:
        try:
            sock.connect(("127.0.0.1", 8766))
            break
        except OSError:
            time.sleep(0.5)
    while True:
        ok, frame = cam.read()
        if not ok:
            break
        frame = cv2.flip(frame, 1)
        result = tracker.process_frame(frame)
        people = result.get("persons", [])
        pts = []
        if people:
            for p in people[0]["keypoints"]:
                pts.append([float(p[0])/frame.shape[1],
                            float(p[1])/frame.shape[0],
                            float(p[2])])
        sock.sendall((json.dumps({"points":pts})+"\n").encode())
        for x,y,c in pts:
            if c >= .35:
                cv2.circle(frame,(int(x*frame.shape[1]),
                                  int(y*frame.shape[0])),4,(0,255,0),-1)
        cv2.imshow("VirtualFittingRoom Camera", frame)
        if cv2.waitKey(1)&0xff in (ord('q'),27):
            break
finally:
    cam.release()
    sock.close()
    cv2.destroyAllWindows()
    tracker.detector.close()
